    // Return the most repeated for in the input string.
    static Set<String> stopWords = new HashSet<>(Arrays.asList(
    "the", "a", "or", "an", "it", "and", "but", "is", 
    "are", "of", "on", "to", "was", "were", "in", "that", "i", 
    "your", "his", "their", "her", "you", "me", "they", "at", "be"
));
    static String mostRepeatedWord(String text) {
        // Your code goes here.
        String[] spyd= text.split("[\\s.,:;!?(){]+");

        List<String> al = Arrays.asList(spyd);

        Map<String, Long> hm = al.stream().filter(x -> !stopWords.contains(x)).map(String :: toLowerCase) .collect(Collectors.groupingBy(i -> i, Collectors.counting()));
